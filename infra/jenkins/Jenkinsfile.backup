// Jenkins job: family-tree-backup-weekly
// Chạy hàng tuần trên cicd.kimtudien.com.vn, SSH vào VPS production
// (giapha.kimtudien.com.vn) và chạy infra/scripts/backup.sh tại đó.
//
// Backup nằm lại trên VPS (~/backups/family-tree/), ĐỒNG THỜI 2 file vừa
// tạo được scp về workspace Jenkins và archiveArtifacts — tải trực tiếp
// qua link trên trang build Jenkins ("Build Artifacts"), không cần SSH/scp
// thủ công (theo yêu cầu 2026-09).
//
// Thiết lập job trong Jenkins UI (một lần, xem thêm infra/jenkins/README.md):
//   - New Item -> Pipeline -> Pipeline script from SCM -> trỏ repo này,
//     "Script Path": infra/jenkins/Jenkinsfile.backup
//   - Build Triggers: KHÔNG cần tick "Poll SCM" — trigger đã khai báo
//     ngay trong file này (cron). Nếu Jenkins của bạn không tự đọc
//     `triggers{}` từ Pipeline-from-SCM ở lần chạy đầu, chạy tay 1 lần
//     rồi lần sau cron sẽ tự áp dụng (giới hạn đã biết của Jenkins).
//   - Credentials cần tạo trước trong Jenkins (Manage Jenkins -> Credentials):
//       vps-ssh-key   (SSH Username with private key, username = user SSH VPS)

pipeline {
    agent any

    triggers {
        // Mỗi Chủ nhật ~02:00 (giờ server Jenkins). Đổi giờ nếu server ở
        // múi giờ khác VN.
        cron('H 2 * * 0')
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        // Artifact backup (mysql+minio) khá nặng — chỉ giữ vài build gần nhất
        // để tránh phình đĩa Jenkins (VPS đã giữ bản đầy đủ 60 ngày riêng).
        buildDiscarder(logRotator(numToKeepStr: '8'))
    }

    parameters {
        string(
            name: 'VPS_HOST',
            defaultValue: 'giapha.kimtudien.com.vn',
            description: 'Host/IP của VPS production.'
        )
        string(
            name: 'VPS_USER',
            defaultValue: 'ubuntu',
            description: 'User SSH trên VPS (đổi cho khớp user thật của bạn).'
        )
        string(
            name: 'VPS_PROJECT_DIR',
            defaultValue: '~/projects/family-tree',
            description: 'Thư mục repo trên VPS (khớp .github/workflows/deploy.yml).'
        )
        string(
            name: 'VPS_SSH_PORT',
            defaultValue: '2024',
            description: 'Cổng SSH của VPS (không phải 22 mặc định — đổi cho khớp secrets.VPS_PORT trong GitHub Actions nếu khác).'
        )
    }

    stages {
        stage('Backup MySQL + MinIO trên VPS') {
            steps {
                sshagent(credentials: ['vps-ssh-key']) {
                    sh '''
                        set -euo pipefail

                        # VPS_PROJECT_DIR trên VPS có thể lệch nhánh/thiếu file so với
                        # commit Jenkins vừa checkout (không tự git-pull vì có thể có
                        # thay đổi cục bộ khác trên đó) — nên LUÔN đẩy đúng bản
                        # backup.sh vừa checkout lên trước khi chạy, tránh chạy nhầm
                        # bản cũ trên VPS.
                        ssh -p "${VPS_SSH_PORT}" -o StrictHostKeyChecking=accept-new "${VPS_USER}@${VPS_HOST}" \
                            "mkdir -p ${VPS_PROJECT_DIR}/infra/scripts"
                        scp -P "${VPS_SSH_PORT}" -o StrictHostKeyChecking=accept-new \
                            infra/scripts/backup.sh "${VPS_USER}@${VPS_HOST}:${VPS_PROJECT_DIR}/infra/scripts/backup.sh"

                        STAMP="$(date +%Y%m%d-%H%M%S)"
                        ssh -p "${VPS_SSH_PORT}" -o StrictHostKeyChecking=accept-new "${VPS_USER}@${VPS_HOST}" \
                            "cd ${VPS_PROJECT_DIR} && chmod +x infra/scripts/backup.sh && STAMP=${STAMP} ./infra/scripts/backup.sh"

                        mkdir -p downloaded-backups
                        scp -P "${VPS_SSH_PORT}" -o StrictHostKeyChecking=accept-new \
                            "${VPS_USER}@${VPS_HOST}:~/backups/family-tree/*-${STAMP}.*" downloaded-backups/
                    '''
                }
            }
        }
        stage('Lưu backup làm Jenkins artifact') {
            steps {
                archiveArtifacts artifacts: 'downloaded-backups/*', fingerprint: true
            }
        }
    }

    post {
        failure {
            echo 'Backup thất bại — kiểm tra log ở trên (thường do MYSQL_ROOT_PASSWORD thiếu trong .env VPS, hoặc docker volume minio_data đổi tên).'
        }
    }
}
