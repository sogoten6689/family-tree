# Copy thành .env ở thư mục gốc repo trước khi deploy VPS:
#   cp .env.production.example .env
#
# Docker Compose đọc các biến ${...} trong docker-compose.yml

# ── MinIO (lưu file tài liệu) ─────────────────────────────────────────────
# KHÔNG cần đăng ký bên thứ ba — Docker Compose tự tạo MinIO với credential mặc định.
# Backend và container minio PHẢI khớp nhau:

MINIO_PUBLIC_ENDPOINT=http://giapha.kimtudien.com.vn/minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# (Khuyến nghị production sau này) đổi cả 4 chỗ cùng lúc:
#   .env → MINIO_ACCESS_KEY / MINIO_SECRET_KEY
#   docker-compose.yml → minio service MINIO_ROOT_USER / MINIO_ROOT_PASSWORD

# ── Kim Hán Nôm OCR (bên ngoài — BẮT BUỘC nếu dùng OCR) ───────────────────
# Khuyến nghị: lưu qua Admin → Developer → Hán-Nôm →「Lưu lên server (DB)」
# Backend mã hóa username/password/token; tự re-login khi JWT hết hạn.
#
# Cách A — API (khuyến nghị production):
# curl -X PUT .../api/developer/hannom/credentials -d '{"username":"...","password":"..."}'
#
# Cách B — override tạm (env, ưu tiên hơn DB):
# HANNOM_API_TOKEN=...
#
# HANNOM_EMAIL=your@email.hcmus.edu.vn
# HANNOM_PASSWORD=your-password
