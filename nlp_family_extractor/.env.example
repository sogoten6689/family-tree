MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=family-tree-docs
MINIO_USE_SSL=false
MINIO_AUTO_CREATE_BUCKET=true
MINIO_PRESIGN_EXPIRES=3600
MINIO_MAX_UPLOAD_BYTES=52428800
