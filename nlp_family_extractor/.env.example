# Auth
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@giapha.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FULL_NAME=System Admin

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3309
MYSQL_DATABASE=family_tree
