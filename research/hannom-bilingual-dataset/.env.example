# Copy thành .env (không commit) rồi điền giá trị thật. Xem README.md mục
# "5 tool OCR-vote" để biết vai trò từng biến.

# DeepSeek API — lấy tại https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Google Cloud Vision — service account JSON key (KHÔNG copy nội dung key vào
# đây, chỉ trỏ đường dẫn). Đặt file key ở secrets/google_vision_sa.json (thư
# mục secrets/ đã có trong .gitignore) hoặc đường dẫn tuyệt đối khác trên máy.
GOOGLE_APPLICATION_CREDENTIALS=secrets/google_vision_sa.json

# GOOGLE_API_KEY (dùng cho gemini.py, vai trò OCR) đọc từ file .env khác, xem
# family_tree_env trong scripts/ocr_adapters/gemini.py — không cần khai báo
# lại ở đây trừ khi muốn tách độc lập khỏi repo family-tree.
