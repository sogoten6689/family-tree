# Copy to .env and fill in values:
# cp .env.example .env

# Google Gemini — tạo key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional: override default system prompt (see HUONG_DAN_GAN_NHAN.md)
# GEMINI_SYSTEM_PROMPT=

# Label Studio — chạy: pip install label-studio && label-studio start
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=
LABEL_STUDIO_PROJECT_ID=
LABEL_STUDIO_PROJECT_TITLE=Family Tree NER+RE
LABEL_STUDIO_MODEL_VERSION=gemini-preannotation

# Crawl defaults (Bước 1)
CRAWL_START=100
CRAWL_END=200
CRAWL_OUTPUT_DIR=data/vgp_corpus
PILOT_LIMIT=10
